# VITE_APP_TITLE=<固定的浏览器标题>（未设置时随控制台语言，见 locales 的 app.title）
VITE_APP_NAME=UJCMS
VITE_PORT=5173
VITE_PUBLIC_PATH=./
VITE_PROXY_API=http://localhost:8080
VITE_PROXY_UPLOADS=http://localhost:8080
VITE_PROXY_THEMES=http://localhost:8080
VITE_BASE_API=/api
VITE_BASE_UPLOADS=/uploads
VITE_BASE_THEMES=/themes
VITE_I18N_LOCALE=zh-cn
VITE_I18N_FALLBACK_LOCALE=zh-cn
# SSR 实时预览源（§8.0）：renderMode=ssr 站点的预览 iframe 指向的 Next/Nuxt 服务。
# 开发期默认 http://localhost:3000（要预览 Nuxt 时改为其端口）；生产留空表示同源相对路径。
VITE_SSR_PREVIEW_ORIGIN=http://localhost:3000
