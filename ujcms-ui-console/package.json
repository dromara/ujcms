{
  "name": "ujcms-cp",
  "version": "13.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "build:starter": "pnpm type-check && vite build --outDir ../ujcms-starter/src/main/webapp/cp --emptyOutDir",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "lint-staged": "lint-staged",
    "plop": "plop"
  },
  "dependencies": {
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/vue-next": "^1.22.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.3",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "14.4.0",
    "axios": "^1.20.0",
    "bpmn-js": "^17.11.1",
    "bytemd": "^1.22.0",
    "codemirror": "^6.0.2",
    "cropperjs": "^1.6.3",
    "dayjs": "^1.11.23",
    "diagram-js": "^14.11.3",
    "diagram-js-direct-editing": "^3.5.1",
    "diff-match-patch": "^1.0.5",
    "domutils": "^4.0.2",
    "echarts": "^6.1.0",
    "element-plus": "~2.14.5",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^12.0.0",
    "js-cookie": "^3.0.8",
    "katex": "^0.16.47",
    "lodash-es": "^4.18.1",
    "min-dash": "^4.2.3",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.3.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "sm-crypto": "^0.5.7",
    "sortablejs": "1.14.0",
    "tinymce": "~6.8.6",
    "turndown": "^7.2.4",
    "vue": "^3.5.42",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/diff-match-patch": "^1.0.36",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.4",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/sm-crypto": "^0.3.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "prettier": "3.9.6",
    "rollup-plugin-license": "3.7.1",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "prettier": {
    "printWidth": 180,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(package)*.json,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.{scss,html}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
