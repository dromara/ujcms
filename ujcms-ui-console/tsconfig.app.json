{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue", "auto-imports.d.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "noImplicitAny": false,
    "types": ["vite/client", "element-plus/global"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
