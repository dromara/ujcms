{
  "name": "TopicList",
  "version": "1.0.0",
  "description": "自动获取最新的专题列表（商业版功能）。",
  "label": { "zh-CN": "专题列表", "en": "Topic list" },
  "tags": ["region", "aside", "topic"],
  "presentation": { "icon": "card", "group": { "zh-CN": "内容组件", "en": "Content" }, "order": 16, "thumbnail": "thumbnails/topic-list.svg" },
