# ===================================================
# Theme build outputs (copied vendor files)
# ===================================================
**/assets/vendor/

# ===================================================
# Spring Boot webapp runtime files
# 增删本节条目时同步根目录 .dockerignore（本机构建镜像时这些运行期产物同样不得带入）
# ===================================================
# 上传目录只有 avatar（默认头像）是源码，其余均为运行时产物，
# 含种子导入复制进来的 uploads/theme-seed/（theme-marketplace A6：首装/演示导入，可确定性重生成）
src/main/webapp/uploads/*
!src/main/webapp/uploads/avatar/
src/main/webapp/uploads_test/
# 主题包库 LOCAL 缺省根目录（install-flow §6 P3：运行时包存储，非源码）
src/main/webapp/theme-packages/
# Theme dirs of sites with ID >= 100 (created at runtime by live tests; snowflake IDs)
src/main/webapp/themes/[0-9][0-9][0-9]*/
src/main/webapp/WEB-INF/backup/
# lucene、lucene_test，以及临时启动用的 lucene_<x>（--ujcms.lucene-path=/WEB-INF/lucene_<x>）
src/main/webapp/WEB-INF/lucene*/
src/main/webapp/WEB-INF/install-token.txt
src/main/webapp/WEB-INF/license/

# Static HTML (generated by CMS)
src/main/webapp/articles/
src/main/webapp/channels/
src/main/webapp/index.html

# Admin control panel (generated by ujcms-ui-console)
src/main/webapp/cp/
