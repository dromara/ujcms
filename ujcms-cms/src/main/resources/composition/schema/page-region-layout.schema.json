{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ujcms.com/schema/composition/page-region-layout.schema.json",
  "title": "UJCMS Page Region Layout",
  "description": "页面区域结构树（rows → columns → panel-ids）。结构即数据；面板内容是投放（Panel = Placement），由 panel-id 引用。列数须等于行布局的列数、面板ID须属于本区域等跨字段规则由服务端据 RowLayoutCatalog 校验。",
  "type": "object",
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "row": {
      "type": "object",
      "required": ["id", "layout", "columns"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "客户端生成的稳定行ID（浏览器编辑器内随机生成）"
        },
        "layout": {
          "enum": ["full", "halves", "thirds", "twoThirdsLeft", "twoThirdsRight", "quarters", "sidebarLeft", "sidebarRight"],
          "description": "行布局键（行布局目录 RowLayoutCatalog）"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["panels"],
      "properties": {
        "panels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "区域面板的投放ID"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
